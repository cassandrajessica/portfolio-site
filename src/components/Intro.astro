---
/* ==========================================================================
   Intro.astro: the statement section right below the hero
   - A big uppercase Anton statement, first line indented to a grid line,
     ending in a red phrase
   - A smaller paragraph of body copy below it
   - When the statement scrolls into view, its lines slide up into place
     one after another (data-text-reveal, see src/scripts/text-reveal.ts)
   ========================================================================== */

// ---------- Copy: edit the text here ----------
// The statement is split in two: the main part, and the closing phrase
// that shows in red.
const statement =
  "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore";
const highlight = "magna aliqua.";

const body =
  "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.";
---

<section class="intro" id="intro">
  <h2 class="intro-statement" data-text-reveal>
    <span class="intro-indent" aria-hidden="true"></span>{`${statement} `}<span
      class="accent">{highlight}</span
    >
  </h2>

  <p class="intro-body" data-reveal>{body}</p>
</section>

<style>
  /* ---------- Layout ----------
     --column is the width of one background grid column. The first line
     of the statement and the body copy both start at the first grid line
     after the left edge. (The section already has the gutter as padding,
     so we subtract it.) */
  .intro {
    --column: calc(100vw / var(--grid-columns));
    --to-grid-line: calc(var(--column) - var(--gutter));

    padding-inline: var(--gutter);
    padding-block: var(--section-space);
  }

  /* ---------- Statement ---------- */
  .intro-statement {
    font-size: var(--text-statement);
    line-height: var(--leading-heading);
    text-wrap: wrap; /* overrides the global "balance", which would fight the indent */
  }

  /* An empty spacer at the start pushes the first line in to a grid line.
     (A spacer instead of text-indent: text-indent gets inherited by the
     line-splitting script's word wrappers and throws off its measurements.) */
  .intro-indent {
    display: inline-block;
    width: var(--to-grid-line);
  }

  /* ---------- Body copy ---------- */
  .intro-body {
    margin-top: var(--space-8);
    margin-left: var(--to-grid-line); /* lines up with the statement's first line */
    max-width: 42ch;
    font-size: var(--text-small);
    line-height: var(--leading-body);
    color: var(--color-muted);
  }

  /* ---------- Mobile (under 768px) ----------
     PROPOSAL, pending your approval: the body copy goes full width under
     the statement. The indent and text size shrink on their own, since
     they're based on the screen width. */
  @media (max-width: 767px) {
    .intro-body {
      margin-left: 0;
      margin-top: var(--space-6);
    }
  }
</style>
