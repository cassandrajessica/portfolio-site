---
/* ==========================================================================
   Intro.astro: the statement section right below the hero
   - A big uppercase Anton statement, first line indented to a grid line,
     ending in a red phrase
   - A smaller paragraph of body copy below it
   - As you scroll through, the statement's words darken one by one
   ========================================================================== */

// ---------- Copy: edit the text here ----------
// The statement is split in two: the main part, and the closing phrase
// that shows in red.
const statement =
  "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore";
const highlight = "magna aliqua.";

const body =
  "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.";

// Each word becomes its own <span> so the script can darken them one by one
const statementWords = statement.split(" ");
const highlightWords = highlight.split(" ");
---

<section class="intro" id="intro">
  <h2 class="intro-statement" data-intro-statement>
    {
      statementWords.map((word) => (
        <>
          <span class="word" data-word>{word}</span>{" "}
        </>
      ))
    }
    {
      highlightWords.map((word, i) => (
        <>
          <span class="word accent" data-word>{word}</span>
          {i < highlightWords.length - 1 && " "}
        </>
      ))
    }
  </h2>

  <p class="intro-body" data-reveal>{body}</p>
</section>

<style>
  /* ---------- Layout ----------
     --column is the width of one background grid column. The first line
     of the statement and the body copy both start at the first grid line
     after the left edge. (The section already has the gutter as padding,
     so we subtract it.) */
  .intro {
    --column: calc(100vw / var(--grid-columns));
    --to-grid-line: calc(var(--column) - var(--gutter));

    padding-inline: var(--gutter);
    padding-block: var(--section-space);
  }

  /* ---------- Statement ---------- */
  .intro-statement {
    font-size: var(--text-statement);
    line-height: var(--leading-heading);
    text-indent: var(--to-grid-line); /* first line starts at a grid line */
    text-wrap: wrap; /* overrides the global "balance", which would fight the indent */
  }

  /* ---------- Body copy ---------- */
  .intro-body {
    margin-top: var(--space-8);
    margin-left: var(--to-grid-line); /* lines up with the statement's first line */
    max-width: 42ch;
    font-size: var(--text-small);
    line-height: var(--leading-body);
    color: var(--color-muted);
  }

  /* ---------- Mobile (under 768px) ----------
     PROPOSAL, pending your approval: the body copy goes full width under
     the statement. The indent and text size shrink on their own, since
     they're based on the screen width. */
  @media (max-width: 767px) {
    .intro-body {
      margin-left: 0;
      margin-top: var(--space-6);
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const statement = document.querySelector<HTMLElement>("[data-intro-statement]");
  const words = statement
    ? Array.from(statement.querySelectorAll<HTMLElement>("[data-word]"))
    : [];

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  // Settings: tweak these to taste
  const START_OPACITY = 0.15; // how faded the words are before you reach them

  // With reduced motion, the words simply stay fully visible
  if (statement && words.length && !prefersReducedMotion) {
    // Word-by-word highlight, tied to scrolling ("scrub"). As the statement
    // moves from the lower part of the screen to the upper part, each word
    // darkens in turn. Scrolling back up fades them again.
    gsap.fromTo(
      words,
      { opacity: START_OPACITY },
      {
        opacity: 1,
        ease: "none",
        stagger: 0.1,
        scrollTrigger: {
          trigger: statement,
          start: "top 80%", // starts when the top of the statement is 80% down the screen
          end: "bottom 45%", // finishes when its bottom reaches 45% down the screen
          scrub: 0.5, // follows the scroll, with half a second of smoothing
        },
      }
    );
  }
</script>
