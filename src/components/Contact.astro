---
/* ==========================================================================
   Contact.astro: "Ready to connect?" section
   - Big heading, and a "Let's talk" pill you slide to reveal the email
   - Icon circles that drop in with real physics (Matter.js) when the
     section scrolls into view, then get pushed around by the mouse
   Settings for the email, the physics and the slider are at the top of
   the <script> below.
   ========================================================================== */

// ---------- Circles ----------
// Each circle gets an icon and a style. The icon list repeats to make
// CIRCLE_COUNT circles; phones show the first 12 (see the CSS at the bottom).
const CIRCLE_COUNT = 26;
const icons: Record<string, string> = {
  code: "M8 7l-5 5 5 5M16 7l5 5-5 5",
  monitor: "M4 5h16v10H4zM9 19h6M12 15v4",
  chat: "M4 5h16v10H10l-6 4z",
  search: "M10.5 4a6.5 6.5 0 1 0 0 13a6.5 6.5 0 1 0 0-13zM20 20l-4.8-4.8",
  globe:
    "M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18zM3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18",
  chart: "M5 20V11M12 20V4M19 20v-6",
  layers: "M12 3l9 5-9 5-9-5zM3 13l9 5 9-5",
  terminal: "M5 7l5 5-5 5M12 18h7",
  mail: "M4 6h16v12H4zM4 7l8 6 8-6",
  cursor: "M6 4l12 6-5 2-2 5z",
  bolt: "M13 3L5 14h6l-1 7 8-11h-6z",
  rocket:
    "M14 4c3 0 6 3 6 6l-6 6-6-6c0-3 3-6 6-6zM8 16l-3 3M9 13l-3-1M11 15l1 3M15 9.5a1 1 0 1 0 0 .01",
  palette:
    "M12 3a9 9 0 0 0 0 18c1.5 0 2-1 2-2s-1-1.5-1-2.5 1-1.5 2-1.5h2a4 4 0 0 0 4-4c0-4.4-4-8-9-8zM7.5 11h.01M10 7.5h.01M14.5 7.5h.01",
  database:
    "M12 4c4.4 0 8 1.3 8 3s-3.6 3-8 3-8-1.3-8-3 3.6-3 8-3zM4 7v10c0 1.7 3.6 3 8 3s8-1.3 8-3V7M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3",
  branch:
    "M6 3v12M6 15a3 3 0 1 0 0 6a3 3 0 1 0 0-6zM18 6a3 3 0 1 0 0 .01M18 9c0 5-6 4-12 6",
  sparkle: "M12 3l2 6 6 2-6 2-2 6-2-6-6-2 6-2z",
};

const styles = ["red", "ink", "outline"] as const;
const iconNames = Object.keys(icons);
const circles = Array.from({ length: CIRCLE_COUNT }, (_, i) => ({
  icon: icons[iconNames[i % iconNames.length]],
  style: styles[(i * 2) % styles.length],
}));
---

<section class="contact" id="contact" data-contact>
  <!-- The physics playground: circles are placed here by the script.
       Decorative, so screen readers skip it. -->
  <div class="circles" aria-hidden="true" data-circles>
    {
      circles.map((circle) => (
        <div class:list={["circle", `circle-${circle.style}`]} data-circle>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d={circle.icon} />
          </svg>
        </div>
      ))
    }
  </div>

  <div class="contact-content" data-contact-content>
    <h2 class="contact-heading" data-text-reveal>
      Ready to<br /><span class="accent">connect?</span>
    </h2>

    <!-- Slide-to-reveal email -->
    <div class="talk" data-talk>
      <div class="talk-track" data-talk-track>
        <button
          class="talk-knob"
          type="button"
          aria-label="Reveal email address. Slide right, or press Enter."
          data-talk-knob
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </button>

        <div class="talk-text" data-talk-text>
          <span class="talk-title">Let's talk</span>
          <span class="talk-hint">Slide all the way to reveal email</span>
        </div>

        <span class="talk-arrows" aria-hidden="true" data-talk-text>&gt;&gt;&gt;</span>
      </div>

      <!-- Shown after the slide. The email is filled in by the script, so
           it never appears in the page's HTML (keeps basic spam bots out). -->
      <div class="talk-revealed" data-talk-revealed hidden>
        <a class="talk-email" data-talk-email></a>
        <button class="talk-copy" type="button" aria-label="Copy email address" data-talk-copy>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 9h11v11H9zM5 15H4V4h11v1" />
          </svg>
        </button>
        <span class="talk-copied" role="status" aria-live="polite" data-talk-status></span>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center; /* heading and slider in the middle */
    padding: var(--section-space) var(--gutter);
    overflow: clip; /* circles falling in from above stay inside the section */
  }

  /* ---------- Circles ---------- */
  .circles {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none; /* never blocks clicks on the slider */
  }

  .circle {
    --size: 4.5rem;

    position: absolute;
    top: 0;
    left: 0;
    width: var(--size);
    height: var(--size);
    display: grid;
    place-items: center;
    border-radius: 50%;
    visibility: hidden; /* shown by the script once it's placed */
    will-change: transform;
  }

  .circle svg {
    width: 42%;
    height: 42%;
  }

  .circle-red {
    background: var(--color-accent);
    color: var(--color-bg);
  }

  .circle-ink {
    background: var(--color-ink);
    color: var(--color-bg);
  }

  .circle-outline {
    border: 1.5px solid var(--color-ink);
    color: var(--color-ink);
    background: var(--color-bg);
  }

  /* ---------- Heading + slider ---------- */
  .contact-content {
    position: relative;
    z-index: 1; /* above the circles */
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    text-align: center;
  }

  .contact-heading {
    font-size: var(--text-section);
    line-height: var(--leading-display);
  }

  /* ---------- "Let's talk" pill ---------- */
  .talk {
    --knob: 2.75rem;

    position: relative;
    width: min(100%, 24rem);
    height: 3.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-ink);
    color: var(--color-bg);
  }

  .talk-track {
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: 0 var(--space-5) 0 0.375rem;
  }

  .talk-track[hidden] {
    display: none;
  }

  .talk-knob {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    width: var(--knob);
    height: var(--knob);
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-bg);
    cursor: grab;
    touch-action: none; /* lets a finger drag it without scrolling the page */
  }

  .talk-knob:active {
    cursor: grabbing;
  }

  .talk-knob svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .talk-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    pointer-events: none;
  }

  .talk-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    text-transform: uppercase;
  }

  .talk-hint,
  .talk-arrows {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    opacity: 0.6;
  }

  .talk-arrows {
    margin-left: auto;
    pointer-events: none;
  }

  /* Revealed state: email + copy button fill the pill */
  .talk-revealed {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 0 var(--space-3) 0 var(--space-5);
  }

  .talk-revealed[hidden] {
    display: none;
  }

  .talk-email {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: var(--text-small);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color var(--duration-fast) var(--ease-out);
  }

  .talk-email:hover,
  .talk-email:focus-visible {
    text-decoration-color: currentColor;
  }

  .talk-copy {
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-bg);
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .talk-copy:hover {
    transform: scale(1.08);
  }

  .talk-copy svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  /* "Copied!" bubble, above the copy button */
  .talk-copied {
    position: absolute;
    right: 0;
    bottom: calc(100% + var(--space-2));
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-bg);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.04em;
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-out);
    pointer-events: none;
  }

  .talk-copied.is-visible {
    opacity: 1;
  }

  /* ---------- Mobile (under 768px) ----------
     Approved: fewer, smaller circles; heading and pill full width. */
  @media (max-width: 767px) {
    .circle {
      --size: 3.25rem;
    }

    .circle:nth-child(n + 13) {
      display: none; /* only the first 12 circles on phones */
    }

    .contact {
      align-items: flex-start;
      padding-top: 30vh; /* room above for circles to fall past */
    }

    .talk {
      width: 100%;
    }
  }
</style>

<script>
  import Matter from "matter-js";
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  /* ---------------------------------------------------------------------
     Settings: tweak these to taste
     --------------------------------------------------------------------- */
  // The email to reveal. Kept in two parts so it never appears whole in the
  // page source. TODO: replace with your real address.
  const EMAIL_USER = "hello";
  const EMAIL_DOMAIN = "example.com";

  const DROP_GAP = 0.07;       // seconds between each circle dropping in
  const PUSH_RADIUS = 160;     // how close the mouse has to be to push a circle (px)
  const PUSH_STRENGTH = 0.004; // how hard the mouse pushes
  const BOUNCE = 0.45;         // 0 = no bounce, 1 = super bouncy

  const section = document.querySelector<HTMLElement>("[data-contact]");
  const layer = document.querySelector<HTMLElement>("[data-circles]");
  const content = document.querySelector<HTMLElement>("[data-contact-content]");
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* ---------------------------------------------------------------------
     1. Falling circles
     --------------------------------------------------------------------- */
  if (section && layer && content) {
    const { Engine, Bodies, Body, Composite } = Matter;

    // Only the circles currently shown (phones hide some with CSS)
    const elements = Array.from(layer.querySelectorAll<HTMLElement>("[data-circle]")).filter(
      (el) => getComputedStyle(el).display !== "none"
    );

    const engine = Engine.create();
    engine.gravity.y = 1;

    const heading = content.querySelector<HTMLElement>(".contact-heading");
    const pill = content.querySelector<HTMLElement>("[data-talk]");

    // The boxes around each line of the heading text, measured from the
    // actual words on screen. A Range over the heading returns one box per
    // word-run; boxes on the same line are merged into one per line.
    const headingLineBoxes = () => {
      if (!heading) return [];
      const range = document.createRange();
      range.selectNodeContents(heading);
      const lines: DOMRect[] = [];
      Array.from(range.getClientRects()).forEach((rect) => {
        if (rect.width < 1 || rect.height < 1) return;
        const sameLine = lines.find((line) => Math.abs(line.top - rect.top) < rect.height / 2);
        if (sameLine) {
          const left = Math.min(sameLine.left, rect.left);
          const right = Math.max(sameLine.right, rect.right);
          sameLine.x = left;
          sameLine.width = right - left;
        } else {
          lines.push(DOMRect.fromRect(rect));
        }
      });
      return lines;
    };

    // Invisible walls the circles collide with:
    // - floor, left and right edges of the section
    // - one box per line of the heading, fitted to the text, so circles can
    //   land on the letters and roll off the edges naturally
    // - a rounded pill shape over the slider, so circles roll off its ends
    let walls: Matter.Body[] = [];
    const buildWalls = () => {
      Composite.remove(engine.world, walls);
      const w = layer.clientWidth;
      const h = layer.clientHeight;
      const t = 200; // wall thickness
      const origin = layer.getBoundingClientRect();
      const local = (rect: DOMRect) => ({
        x: rect.left - origin.left + rect.width / 2,
        y: rect.top - origin.top + rect.height / 2,
      });

      walls = [
        Bodies.rectangle(w / 2, h + t / 2, w + t * 2, t, { isStatic: true }), // floor
        Bodies.rectangle(-t / 2, h / 2 - 1000, t, h * 2 + 2000, { isStatic: true }), // left
        Bodies.rectangle(w + t / 2, h / 2 - 1000, t, h * 2 + 2000, { isStatic: true }), // right
      ];

      // Heading lines
      headingLineBoxes().forEach((line) => {
        const center = local(line);
        walls.push(
          Bodies.rectangle(center.x, center.y, line.width, line.height * 0.9, {
            isStatic: true,
            chamfer: { radius: 4 }, // slightly softened corners
          })
        );
      });

      // Slider pill: fully rounded ends
      if (pill) {
        const box = pill.getBoundingClientRect();
        const center = local(box);
        walls.push(
          Bodies.rectangle(center.x, center.y, box.width, box.height, {
            isStatic: true,
            chamfer: { radius: box.height / 2 },
          })
        );
      }

      Composite.add(engine.world, walls);
    };

    // One physics body per circle, linked to its element
    const pairs = elements.map((el) => {
      const radius = el.offsetWidth / 2;
      return {
        el,
        radius,
        body: Bodies.circle(0, 0, radius, {
          restitution: BOUNCE,
          friction: 0.1,
          frictionAir: 0.015,
          density: 0.002,
        }),
      };
    });

    // Copies each body's position and rotation onto its element
    const render = () => {
      pairs.forEach(({ el, radius, body }) => {
        el.style.transform = `translate(${body.position.x - radius}px, ${body.position.y - radius}px) rotate(${body.angle}rad)`;
      });
    };

    // Circles drop from anywhere across the full width, including right
    // above the heading, and land wherever physics takes them
    const dropX = (radius: number) =>
      radius + Math.random() * (layer.clientWidth - radius * 2);

    // Puts a circle just above the section
    const dropIn = (pair: (typeof pairs)[number]) => {
      Body.setPosition(pair.body, {
        x: dropX(pair.radius),
        y: -pair.radius * 2 - Math.random() * 200,
      });
      Body.setAngle(pair.body, Math.random() * Math.PI * 2);
      Composite.add(engine.world, pair.body);
      pair.el.style.visibility = "visible";
    };

    buildWalls();

    if (prefersReducedMotion) {
      // Reduced motion: run the simulation instantly behind the scenes and
      // show the circles already settled. No falling, no pushing.
      // (waits for the fonts so the heading is measured at its real size)
      document.fonts.ready.then(() => {
        buildWalls();
        pairs.forEach(dropIn);
        for (let i = 0; i < 600; i++) Engine.update(engine, 1000 / 60);
        render();
      });
    } else {
      // Physics only runs while the section is on screen, to save battery
      let running = false;
      const step = () => {
        Engine.update(engine, 1000 / 60);
        render();
      };
      const start = () => {
        if (!running) gsap.ticker.add(step);
        running = true;
      };
      const stop = () => {
        gsap.ticker.remove(step);
        running = false;
      };

      ScrollTrigger.create({
        trigger: section,
        start: "top bottom",
        end: "bottom top",
        onToggle: (self) => (self.isActive ? start() : stop()),
      });

      // Drop the circles in one by one when the section comes into view
      ScrollTrigger.create({
        trigger: section,
        start: "top 60%",
        once: true,
        onEnter: () => {
          buildWalls(); // re-measure the heading and slider right before the drop
          // ...and once more after the heading's own reveal animation has
          // finished, in case its lines were still sliding into place
          gsap.delayedCall(1.2, buildWalls);
          pairs.forEach((pair, i) => gsap.delayedCall(i * DROP_GAP, () => dropIn(pair)));
        },
      });

      // The mouse (or a finger) pushes nearby circles away
      section.addEventListener("pointermove", (event) => {
        const origin = layer.getBoundingClientRect();
        const x = event.clientX - origin.left;
        const y = event.clientY - origin.top;

        pairs.forEach(({ body }) => {
          const dx = body.position.x - x;
          const dy = body.position.y - y;
          const distance = Math.hypot(dx, dy);
          if (distance > PUSH_RADIUS || distance === 0) return;

          // Closer = stronger push, pointing away from the cursor
          const strength = PUSH_STRENGTH * body.mass * (1 - distance / PUSH_RADIUS);
          Body.applyForce(body, body.position, {
            x: (dx / distance) * strength,
            y: (dy / distance) * strength,
          });
        });
      });
    }

    // Keep the walls in the right place if the window is resized
    let resizeTimer: number | undefined;
    window.addEventListener("resize", () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        buildWalls();
        if (prefersReducedMotion) {
          for (let i = 0; i < 300; i++) Engine.update(engine, 1000 / 60);
          render();
        }
      }, 200);
    });
  }

  /* ---------------------------------------------------------------------
     2. Slide to reveal email
     --------------------------------------------------------------------- */
  const talk = document.querySelector<HTMLElement>("[data-talk]");
  const knob = document.querySelector<HTMLButtonElement>("[data-talk-knob]");
  const track = document.querySelector<HTMLElement>("[data-talk-track]");
  const revealed = document.querySelector<HTMLElement>("[data-talk-revealed]");
  const emailLink = document.querySelector<HTMLAnchorElement>("[data-talk-email]");
  const copyButton = document.querySelector<HTMLButtonElement>("[data-talk-copy]");
  const status = document.querySelector<HTMLElement>("[data-talk-status]");
  const texts = Array.from(document.querySelectorAll<HTMLElement>("[data-talk-text]"));

  if (talk && knob && track && revealed && emailLink && copyButton && status) {
    const email = `${EMAIL_USER}@${EMAIL_DOMAIN}`;
    let isRevealed = false;

    // How far the knob can travel: from its start to the pill's right edge
    const maxTravel = () => {
      const padding = parseFloat(getComputedStyle(track).paddingLeft);
      return talk.clientWidth - knob.offsetWidth - padding * 2;
    };

    const reveal = () => {
      if (isRevealed) return;
      isRevealed = true;

      emailLink.textContent = email;
      emailLink.href = `mailto:${email}`;

      const show = () => {
        track.hidden = true;
        revealed.hidden = false;
        if (!prefersReducedMotion) {
          gsap.from(revealed, { opacity: 0, x: -12, duration: 0.4, ease: "power3.out" });
        }
        emailLink.focus({ preventScroll: true });
      };

      if (prefersReducedMotion) {
        show();
      } else {
        gsap.to(knob, { x: maxTravel(), duration: 0.2, ease: "power2.out", onComplete: show });
      }
    };

    // Dragging
    let dragging = false;
    let startX = 0;

    knob.addEventListener("pointerdown", (event) => {
      if (isRevealed) return;
      dragging = true;
      startX = event.clientX - (gsap.getProperty(knob, "x") as number);
      knob.setPointerCapture(event.pointerId);
      gsap.killTweensOf(knob);
    });

    knob.addEventListener("pointermove", (event) => {
      if (!dragging) return;
      const x = gsap.utils.clamp(0, maxTravel(), event.clientX - startX);
      gsap.set(knob, { x });
      // The text fades out as the knob slides over it
      gsap.set(texts, { opacity: 1 - x / maxTravel() });
    });

    const release = () => {
      if (!dragging) return;
      dragging = false;
      const x = gsap.getProperty(knob, "x") as number;

      if (x >= maxTravel() * 0.9) {
        reveal(); // made it (nearly) all the way
      } else {
        // Not far enough: spring back
        gsap.to(knob, {
          x: 0,
          duration: prefersReducedMotion ? 0 : 0.6,
          ease: "elastic.out(1, 0.5)",
        });
        gsap.to(texts, { opacity: 1, duration: 0.3 });
      }
    };
    knob.addEventListener("pointerup", release);
    knob.addEventListener("pointercancel", release);

    // Keyboard: Enter, Space or the right arrow reveals it. (Enter and
    // Space also fire a "click" on buttons, which is handled here too.)
    knob.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") {
        event.preventDefault();
        reveal();
      }
    });
    knob.addEventListener("click", (event) => {
      // A click without dragging (from the keyboard) reveals right away
      if (event.detail === 0) reveal();
    });

    // Copy button
    let statusTimer: number | undefined;
    copyButton.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(email);
        status.textContent = "Copied!";
      } catch {
        // If the clipboard isn't available, select the text so it's easy
        // to copy by hand
        const range = document.createRange();
        range.selectNodeContents(emailLink);
        window.getSelection()?.removeAllRanges();
        window.getSelection()?.addRange(range);
        const isMac = /Mac|iPhone|iPad/.test(navigator.userAgent);
        status.textContent = `Press ${isMac ? "Cmd" : "Ctrl"} + C to copy`;
      }
      status.classList.add("is-visible");
      window.clearTimeout(statusTimer);
      statusTimer = window.setTimeout(() => status.classList.remove("is-visible"), 1800);
    });
  }
</script>
