---
/* ==========================================================================
   Base.astro: the shared page shell
   Every page wraps its content in this layout. It handles the <head>
   (SEO and social tags), loads the design system, and draws the fixed
   background layers: grid lines and grain.
   ========================================================================== */

// Loads the design system (fonts, colors, type, resets) on every page
import "../styles/global.css";
import Nav from "../components/Nav.astro";

// The inputs ("props") each page passes in.
// The "?" means optional: if a page leaves it out, the default below is used.
interface Props {
  title?: string;
  description?: string;
  image?: string; // social share image, path inside /public
}

const {
  title = "Cj Lehman-Vo | Web & App Developer",
  description = "Cj Lehman-Vo builds fast, findable websites and the systems behind them: web development, technical SEO and AEO, and workflow automation.",
  image = "/images/og-image.png",
} = Astro.props;

// Builds full URLs from the "site" value in astro.config.mjs.
// Search engines and social platforms need complete URLs, not relative paths.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph: controls the preview card on LinkedIn, Slack, iMessage, etc. -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />

    <!-- Twitter/X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <!-- Browser UI color on mobile (matches the cream background) -->
    <meta name="theme-color" content="#f3f3e9" />

    <!-- TODO: add a favicon to /public and link it here, e.g.
         <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> -->
  </head>

  <body>
    <!-- Background layers. aria-hidden hides them from screen readers,
         since they're purely decorative. -->
    <div class="bg-grid" aria-hidden="true"></div>
    <div class="bg-grain" aria-hidden="true"></div>
    <canvas class="bg-film" aria-hidden="true"></canvas>

    <Nav />

    <main id="main">
      <slot />
    </main>

    <!-- Footer will go here once we build it -->

    <!-- Site-wide scripts:
         - smooth-scroll: gliding mouse-wheel scrolling (Lenis)
         - reveal: anything with data-reveal rises into view on scroll
         - text-reveal: anything with data-text-reveal slides up line by line
         - film-effects: film dust, fibers and scratches on the canvas -->
    <script>
      import "../scripts/smooth-scroll.ts";
      import "../scripts/reveal.ts";
      import "../scripts/text-reveal.ts";
      import "../scripts/film-effects.ts";
    </script>
  </body>
</html>

<style>
  /* Both background layers are fixed to the screen, sit behind all
     content, and ignore the mouse so they never block clicks. */
  .bg-grid,
  .bg-grain,
  .bg-film {
    position: fixed;
    inset: 0; /* shorthand for top/right/bottom/left: 0, so it fills the screen */
    z-index: var(--z-background);
    pointer-events: none;
  }

  /* Grid lines
     One 1px line at the left edge of a tile, and the tile is
     (100% / number of columns) wide. Repeating the tile across the screen
     draws evenly spaced vertical lines. Change --grid-columns in
     global.css to add or remove lines. */
  .bg-grid {
    background-image: linear-gradient(
      to right,
      var(--color-line) 1px,
      transparent 1px
    );
    background-size: calc(100% / var(--grid-columns)) 100%;
  }

  /* Grain
     An SVG noise filter (feTurbulence) drawn as a tiny repeating image.
     No image file to download. The settings (strength, size, speed) are
     variables in global.css, shared with the nav. */
  .bg-grain {
    /* Extends 200px past every screen edge, so when the layer jumps
       around (the flicker animation) its edges never show. */
    inset: -200px;
    background-image: var(--grain-image);
    background-size: var(--grain-size) var(--grain-size);
    opacity: var(--grain-opacity);
    mix-blend-mode: multiply; /* darkens the cream slightly, like paper texture */

    /* Flicker: the keyframes live in global.css so the nav can share them.
       Visitors with "Reduce motion" turned on get static grain. */
    animation: grain var(--grain-speed) steps(1) infinite;
  }

  /* Film dust, fibers and scratches
     A full-screen <canvas>. The script in src/scripts/film-effects.ts
     draws the marks onto it about 10 times a second. */
  .bg-film {
    width: 100%;
    height: 100%;
  }

  main {
    position: relative;
    z-index: var(--z-content);
  }
</style>
