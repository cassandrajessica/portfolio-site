---
/* ==========================================================================
   index.astro: the homepage (yoursite.com/)
   Sections are added here in page order as we build them.
   ========================================================================== */
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
---

<Base>
  <Hero />

  <!-- TEMPORARY placeholder so "Scroll to explore" has somewhere to go and
       the page is tall enough to test the nav hiding on scroll.
       Replaced by the Intro section next. -->
  <section id="intro" class="container placeholder">
    <p class="label">(01) Intro goes here</p>
  </section>
</Base>

<style>
  .placeholder {
    min-height: 120vh;
    padding-block: var(--section-space);
  }
</style>
