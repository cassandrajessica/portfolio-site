---
/* ==========================================================================
   index.astro: the homepage (yoursite.com/)
   Sections are added here in page order as we build them.
   ========================================================================== */
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Intro from "../components/Intro.astro";
import Experience from "../components/Experience.astro";
---

<Base>
  <Hero />

  <Intro />

  <!-- The Work section will go here, between Intro and Experience -->

  <Experience />

  <!-- TEMPORARY spacer so the page is tall enough to scroll the Intro all
       the way through. Remove once the Work section is added. -->
  <div class="spacer" aria-hidden="true"></div>
</Base>

<style>
  .spacer {
    height: 80vh;
  }
</style>
